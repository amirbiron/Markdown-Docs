# העתק ל-.env לפיתוח מקומי. ב-Render הערכים מגיעים מ-render.yaml.
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/markdown_docs
SESSION_SECRET=change-me
ENVIRONMENT=development
ADMIN_EMAIL=admin@example.com
# לפחות 12 בתים ב-UTF-8, ולכל היותר 72 (תו עברי הוא שני בתים)
ADMIN_PASSWORD=change-me-please
# 0 בפיתוח (אין פרוקסי), 1 ב-Render
TRUSTED_PROXY_HOPS=0

# ── גיבויים ──────────────────────────────────────────────────────────
# יעד הגיבוי היומי. בפרודקשן זו נקודת העגינה של הדיסק הקבוע ב-Render.
BACKUP_DIR=./var/backups
BACKUP_ENABLED=true
BACKUP_EVERY_HOURS=24
BACKUP_KEEP=30

# העותק שיוצא החוצה, מוצפן. כבוי כברירת מחדל.
# BACKUP_PASSPHRASE הוא המפתח לכל התוכן של המערכת — הוא חייב להישמר
# גם מחוץ למערכת, ולא להישלח באותו ערוץ שבו נשלח הגיבוי.
BACKUP_TELEGRAM_ENABLED=false
BACKUP_OFFSITE_EVERY_HOURS=168
BACKUP_PASSPHRASE=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
